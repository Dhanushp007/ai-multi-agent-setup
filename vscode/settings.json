{
  // ── Universal ─────────────────────────────────────────────────────────────
  // Applied to all projects regardless of stack.
  // Stack-specific blocks are tagged [stack: node], [stack: python], [stack: dotnet]
  // so apply.ps1 / apply.sh can filter them by target stack.

  // Editor — core behaviour
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.inlayHints.enabled": "on",
  "editor.suggestSelection": "first",
  "editor.linkedEditing": true,
  "editor.trimAutoWhitespace": true,
  "editor.renderWhitespace": "boundary",

  // Files
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },

  // Search — skip generated/vendor directories
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.venv": true,
    "**/bin": true,
    "**/obj": true,
    "**/.next": true,
    "**/coverage": true
  },

  // Terminal
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.persistentSessionReviveProcess": "never",

  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.pruneOnFetch": true,

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.js.map, ${capture}.spec.ts, ${capture}.test.ts",
    "*.tsx": "${capture}.module.css, ${capture}.stories.tsx",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc, .nvmrc",
    "pyproject.toml": "setup.cfg, setup.py, requirements*.txt, .python-version",
    "*.csproj": "*.sln, nuget.config"
  },

  // Workbench
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.startupEditor": "none",

  // GitHub Copilot
  "github.copilot.enable": { "*": true },
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.localeOverride": "en",
  "chat.editing.confirmEditRequestRemoval": true,

  // JSON/YAML — universal formatter
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "editor.wordWrap": "on" },

  // ── [stack: node] ─────────────────────────────────────────────────────────
  "[javascript]":      { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]":      { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.returnTypes.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "npm.enableRunFromFolder": true,
  // ── [stack: node] ─────────────────────────────────────────────────────────

  // ── [stack: python] ───────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4
  },
  // ── [stack: python] ───────────────────────────────────────────────────────

  // ── [stack: dotnet] ───────────────────────────────────────────────────────
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.enableRoslynAnalyzers": true,
  "dotnetAcquisitionExtension.enableTelemetry": false,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.tabSize": 4
  }
  // ── [stack: dotnet] ───────────────────────────────────────────────────────
}
